{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/agents/crawler/live-runner.ts",
    "src/agents/generator/run.ts",
    "src/agents/generator/unit-generator.ts",
    "src/agents/healer/run.ts",
    "src/agents/planner/run.ts",
    "src/agents/planner/schema.ts",
    "src/agents/planner/normalizer.ts",
    "src/agents/planner/validator.ts",
    "src/agents/planner/markdown-renderer.ts",
    "src/core/action-plan.ts",
    "src/agents/crawler/locator-registry.ts",
    "src/core/locator-resolver.ts",
    "src/core/unit/**/*.ts",
    "tests/unit/**/*.ts"
  ]
}
