{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/agents/crawler/live-runner.ts",
    "src/agents/generator/run.ts",
    "src/agents/healer/run.ts",
    "src/agents/planner/run.ts",
    "src/core/action-plan.ts",
    "src/core/locator-registry.ts",
    "src/core/locator-resolver.ts",
    "src/core/step-parser.ts",
    "tests/unit/**/*.ts"
  ]
}
