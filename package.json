{
  "name": "playwright-javascript-automation",
  "version": "1.0.0",
  "type": "module",
  "description": "Playwright Automation Framework with JavaScript and POM",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/cli.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:unit": "node src/cli.js --level unit",
    "test:unit:cov": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:api": "tsx src/api-test-cli.js",
    "test:core": "vitest run tests/unit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test:e2e": "node src/cli.js --level e2e",
    "setup": "setup.bat",
    "test:all": "node src/cli.js --level unit && node src/cli.js --level e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^16.6.1",
    "jsdom": "^30.0.1",
    "msw": "^2.7.0",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@testcontainers/mysql": "^10.18.0",
    "@testcontainers/postgresql": "^10.18.0",
    "better-sqlite3": "^11.8.1",
    "inquirer": "^9.3.8",
    "openai": "^7.4.0",
    "testcontainers": "^10.18.0"
  }
}
